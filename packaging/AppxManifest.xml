<?xml version="1.0" encoding="utf-8"?>
<!--
  AppxManifest.xml — template describing SANKET to Windows and the Microsoft Store.
  WHY placeholders: Identity Name / Publisher come from Kanak's Partner Center reservation
       (Product identity page). build_msix.ps1 fills {IDENTITY_NAME} {PUBLISHER}
       {PUBLISHER_DISPLAY_NAME} {VERSION} from packaging/store_identity.json.
  Capabilities: runFullTrust (classic desktop app), webcam (signer), microphone (speaker). Nothing else:
       no internet capability is declared because SANKET never goes online.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>SANKET</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>assets\store\StoreLogo.png</Logo>
    <Description>Offline two-way Indian Sign Language and speech translator (Preview, 263 words).</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="hi-in" />
  </Resources>
  <Applications>
    <Application Id="SANKET" Executable="SANKET\SANKET.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="SANKET" Description="ISL ⇄ speech translator, fully offline"
                          BackgroundColor="transparent"
                          Square150x150Logo="assets\store\Square150x150Logo.png"
                          Square44x44Logo="assets\store\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="assets\store\Wide310x150Logo.png"
                         Square310x310Logo="assets\store\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
